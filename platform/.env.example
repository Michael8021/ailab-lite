# AILab platform services — dev profile
# Copy to .env and adjust. Every setting is prefixed with AILAB_.

AILAB_ENV=dev
AILAB_API_BASE_URL=http://127.0.0.1:8080
AILAB_BROKER_BASE_URL=http://127.0.0.1:8081
AILAB_AGENT_BASE_URL=http://127.0.0.1:8082
AILAB_WORKER_BASE_URL=http://127.0.0.1:8083

# data plane (T4 later: postgresql+psycopg://...)
# default: sqlite under platform/var/
# AILAB_DATABASE_URL=sqlite:////abs/path/platform.db
AILAB_REDIS_URL=redis://127.0.0.1:6379/0

# storage: local (dev) | s3 (T4 SeaweedFS/S3)
AILAB_STORAGE_BACKEND=local
# AILAB_STORAGE_ROOT=/abs/path/storage   (default: platform/var/storage)
AILAB_S3_BUCKET=ailab
AILAB_S3_ENDPOINT=
AILAB_S3_ACCESS_KEY=
AILAB_S3_SECRET_KEY=
AILAB_S3_REGION=us-east-1

# auth: replace with Keycloak OIDC in the full platform
AILAB_DEV_TOKEN=dev-demo-token
AILAB_DEV_USER_EMAIL=demo@ailab.local
AILAB_SERVICE_TOKEN=dev-service-token

# models: which ones exist and how each is reached is platform/models.toml (the model catalog).
# A catalog entry names the variable holding its key; the key itself goes here (or in the real
# environment / a Kubernetes Secret), never in models.toml:
AILAB_KEY_DEEPSEEK=
# AILAB_MODELS_FILE=/path/to/models.toml   (default: platform/models.toml)
# retries on 429/5xx/network errors, backoff doubles each time
AILAB_LLM_MAX_RETRIES=2
AILAB_LLM_RETRY_BACKOFF_SECONDS=1.0
# send reasoning_content back to DeepSeek thinking models (version dependent; try if you get 400s)
AILAB_LLM_ECHO_REASONING=false

# sandbox: mock (no isolation, tests) | docker (local runc) | opensandbox (T2)
AILAB_SANDBOX_PROVIDER=docker
AILAB_SANDBOX_IMAGE=harbor.ailab.local/sandbox/sbx-office:lite
AILAB_SANDBOX_TTL_SECONDS=14400
AILAB_MAX_SANDBOXES=1
AILAB_MAX_AGENT_STEPS=12
AILAB_RUN_TIMEOUT_SECONDS=900

# OpenSandbox dev server (only used when provider=opensandbox)
AILAB_OSB_DOMAIN=127.0.0.1:8090
AILAB_OSB_API_KEY=dev-osb-key

# AILAB_CORS_ORIGINS=   (empty: the Portal proxies the API same-origin)

# limits (per user unless noted)
AILAB_DAILY_TOKEN_LIMIT=2000000
AILAB_MONTHLY_TOKEN_LIMIT=30000000
AILAB_LIBRARY_QUOTA_BYTES=21474836480
AILAB_RUN_MAX_TOKENS=2000000
AILAB_MAX_ARTIFACT_BYTES=104857600
AILAB_SANDBOX_WAIT_SECONDS=300

# outside dev/test/smoke/k3s the services refuse to start with the default tokens above

# logs: text (default, with [request_id]) | json (one object per line)
# AILAB_LOG_FORMAT=json
